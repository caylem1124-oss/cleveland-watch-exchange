{
  "name": "cleveland-watch-exchange",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./docs",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "cle-watches-leads",
      "database_id": "REPLACE_WITH_YOUR_NEW_D1_DATABASE_ID"
    }
  ]
}
